* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: Inter, 'Segoe UI', sans-serif;
  background: #050b15;
  color: #ecf8ff;
}

#app {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

#map {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.game-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 4;
}

canvas {
  display: block;
  width: 100%;
  height: 100%;
}

#hud {
  position: absolute;
  left: 24px;
  top: 20px;
  z-index: 10;
  background: rgba(4, 11, 18, 0.58);
  border: 1px solid rgba(125, 211, 252, 0.28);
  backdrop-filter: blur(10px);
  border-radius: 18px;
  padding: 18px 20px;
  box-shadow: 0 14px 40px rgba(0, 0, 0, 0.3);
  min-width: 290px;
}

#title {
  font-size: 1.4rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

#mission,
#status,
#controls {
  margin-top: 10px;
  font-size: 0.88rem;
  color: #d9f1ff;
}

#status {
  color: #7dd3fc;
}

#controls {
  opacity: 0.82;
}

.fallback-panel {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  background: linear-gradient(135deg, rgba(8, 18, 31, 0.94), rgba(18, 33, 49, 0.9));
  z-index: 20;
}

.fallback-panel h2 {
  margin-bottom: 12px;
  font-size: 2rem;
}

.fallback-panel p,
.fallback-panel pre {
  margin: 8px 0;
}

.fallback-panel pre {
  background: rgba(15, 23, 42, 0.8);
  padding: 12px 14px;
  border-radius: 8px;
  border: 1px solid rgba(125, 211, 252, 0.25);
  color: #dbeafe;
  font-family: 'SFMono-Regular', Consolas, monospace;
}
